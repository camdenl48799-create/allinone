# Copy these into your deployment's server-side environment settings.
# Never commit a real secret key or webhook signing secret.
# This integration deliberately accepts only an sk_test_ Stripe secret key.

STRIPE_SECRET_KEY=sk_test_replace_with_your_sandbox_secret
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_test_webhook_secret
STRIPE_PRICE_PRO=price_1UPbkwRnqtg1OjP7opRotxtz
STRIPE_PRICE_PRO_PLUS=price_1UPblTRnqtg1OjP7QOaHIPbv

# Website Clerk session verification. Set these from your WEBSITE Clerk app,
# not the native Windows app's localhost OAuth callback settings.
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret
CLERK_AUTHORIZED_PARTIES=https://your-allinone-domain.example

# Public website origin used for trusted Checkout return URLs.
APP_URL=https://your-allinone-domain.example

<Window x:Class="ALLINONE.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ALLINONE"
 Width="1440"
 Height="900"
 MinWidth="1050"
 MinHeight="700"
 Background="{StaticResource BackgroundBrush}"
 Foreground="{StaticResource TextBrush}"
 WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="13,9"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="10"
              Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
     <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Trigger>
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Opacity" Value="0.48"/>
    </Trigger>
   </Style.Triggers>
  </Style>

  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
  </Style>

  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/>
   <Setter Property="Padding" Value="12,11"/>
   <Setter Property="Margin" Value="0,2"/>
  </Style>

  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Background" Value="{StaticResource InputBrush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="13,10"/>
   <Setter Property="FontSize" Value="14"/>
  </Style>

  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
   <Setter Property="Padding" Value="8,6"/>
   <Setter Property="FontSize" Value="14"/>
  </Style>

  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="FontSize" Value="14"/>
  </Style>

  <Style TargetType="ListBox">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style TargetType="ListBoxItem">
   <Setter Property="Padding" Value="10,9"/>
   <Setter Property="Margin" Value="4,3"/>
  </Style>
 </Window.Resources>

 <Grid>
  <Grid x:Name="SetupView" Visibility="Collapsed" Background="{StaticResource BackgroundBrush}">
   <Border Width="800"
           Padding="48"
           Background="{StaticResource PanelBrush}"
           BorderBrush="{StaticResource BorderBrush}"
           BorderThickness="1"
           CornerRadius="26"
           HorizontalAlignment="Center"
           VerticalAlignment="Center">
    <StackPanel>
     <TextBlock Text="● ALLINONE" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
     <TextBlock Text="ONE AI. EVERY PROJECT." FontSize="16" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,34"/>
     <TextBlock x:Name="SetupStep" Text="01 / 04" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
     <TextBlock x:Name="SetupTitle" Text="Welcome" FontSize="34" FontWeight="SemiBold" Margin="0,13,0,9"/>
     <TextBlock x:Name="SetupDescription" TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,24"/>

     <StackPanel x:Name="NamePanel">
      <TextBlock Text="Display name" Margin="0,0,0,8"/>
      <TextBox x:Name="NameBox" Height="46"/>
     </StackPanel>

     <CheckBox x:Name="SafeModeBox"
               Content="Enable Safe Mode"
               IsChecked="True"
               Margin="0,18,0,0"/>

     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,34,0,0">
      <Button x:Name="SetupBack" Content="Back" Width="100" Margin="0,0,10,0" Click="SetupBack_Click"/>
      <Button x:Name="SetupNext" Content="Continue" Width="130" Style="{StaticResource AccentButton}" Click="SetupNext_Click"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </Grid>

  <Grid x:Name="AppView" Visibility="Collapsed">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="280"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>

   <Border Grid.Column="0"
           Background="{StaticResource PanelBrush}"
           BorderBrush="{StaticResource BorderBrush}"
           BorderThickness="0,0,1,0"
           Padding="16">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="● ALLINONE" FontSize="25" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
      <TextBlock Text="ONE AI. EVERY PROJECT." FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,18"/>

      <Button Content="+  New chat" Style="{StaticResource AccentButton}" Click="NewChat_Click" Height="42"/>

      <StackPanel Margin="0,14,0,6">
       <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,4"/>
       <Button x:Name="NavChat" Style="{StaticResource NavButton}" Content="  ✦   Chat" Tag="Chat" Click="Nav_Click"/>
       <Button x:Name="NavProjects" Style="{StaticResource NavButton}" Content="  ◈   Projects" Tag="Projects" Click="Nav_Click"/>
       <Button x:Name="NavFiles" Style="{StaticResource NavButton}" Content="  ◇   Files" Tag="Files" Click="Nav_Click"/>
       <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Content="  ⚙   Settings" Tag="Settings" Click="Nav_Click"/>
       <Button x:Name="NavAccount" Style="{StaticResource NavButton}" Content="  ◉   Account" Tag="Account" Click="Nav_Click"/>
      </StackPanel>

      <TextBlock Text="RECENT CHATS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="12,14,0,5"/>
      <ListBox x:Name="ChatHistoryList" Height="300" SelectionChanged="ChatHistoryList_SelectionChanged">
       <ListBox.ItemTemplate>
        <DataTemplate>
         <StackPanel>
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding UpdatedUtc, StringFormat={}{0:g}}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
         </StackPanel>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </StackPanel>

     <Border DockPanel.Dock="Bottom"
             Background="{StaticResource Panel2Brush}"
             CornerRadius="12"
             Padding="12"
             Margin="0,12,0,0">
      <StackPanel>
       <TextBlock Text="ENGINE" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
       <TextBlock x:Name="StatusText" Text="● Local Core" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
       <TextBlock x:Name="ProjectStatus" Text="No project selected" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
    </DockPanel>
   </Border>

   <Grid Grid.Column="1" Margin="28">
    <Grid x:Name="ChatPage">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>

     <Grid>
      <StackPanel>
       <TextBlock x:Name="PageTitle" Text="AI Chat" FontSize="31" FontWeight="SemiBold"/>
       <TextBlock x:Name="PageSubtitle" Text="Chat, search, code, math, files, and project context." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
      </StackPanel>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
       <TextBlock Text="Model" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
       <ComboBox x:Name="ModelSelector" Width="230" SelectionChanged="ModelSelector_SelectionChanged" DisplayMemberPath="DisplayName"/>
      </StackPanel>
     </Grid>

     <Grid Grid.Row="1">
      <ScrollViewer x:Name="MessageScroller" VerticalScrollBarVisibility="Auto" Margin="0,20,0,10">
       <StackPanel x:Name="Messages" Width="860" HorizontalAlignment="Center"/>
      </ScrollViewer>
     </Grid>

     <Grid Grid.Row="2">
      <ListBox x:Name="MentionList"
               Visibility="Collapsed"
               MaxHeight="220"
               HorizontalAlignment="Left"
               Width="370"
               Margin="0,0,0,68"
               Background="{StaticResource PanelBrush}"
               BorderBrush="{StaticResource BorderBrush}"
               SelectionChanged="MentionList_SelectionChanged"
               DisplayMemberPath="Label"/>
      <Border Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="16"
              Padding="8">
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition/>
         <ColumnDefinition Width="105"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="PromptBox"
                 Grid.Column="0"
                 MinHeight="56"
                 BorderThickness="0"
                 Background="Transparent"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 MaxLength="12000"
                 TextChanged="PromptBox_TextChanged"
                 KeyDown="PromptBox_KeyDown"/>
        <Button x:Name="SendButton"
                Grid.Column="1"
                Content="Send  →"
                Style="{StaticResource AccentButton}"
                Click="Send_Click"/>
       </Grid>
      </Border>
     </Grid>
    </Grid>

    <Grid x:Name="ProjectsPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="Projects" FontSize="31" FontWeight="SemiBold"/>
      <TextBlock Text="Separate conversations, files, and context by workspace." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,16"/>
      <StackPanel Orientation="Horizontal">
       <Button Content="+ New project" Width="130" Style="{StaticResource AccentButton}" Click="NewProject_Click"/>
       <Button Content="Delete selected" Width="125" Margin="8,0,0,0" Click="DeleteProject_Click"/>
      </StackPanel>
     </StackPanel>
     <ScrollViewer Grid.Row="1" Margin="0,20,0,0">
      <WrapPanel x:Name="ProjectGrid"/>
     </ScrollViewer>
    </Grid>

    <Grid x:Name="FilesPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="Files" FontSize="31" FontWeight="SemiBold"/>
      <TextBlock Text="Attach local text/code files to the current project and preview them safely." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,16"/>
      <StackPanel Orientation="Horizontal">
       <Button Content="Add file" Width="105" Style="{StaticResource AccentButton}" Click="AddFile_Click"/>
       <Button Content="Open" Width="90" Margin="8,0,0,0" Click="OpenFile_Click"/>
       <Button Content="Remove" Width="90" Margin="8,0,0,0" Click="RemoveFile_Click"/>
       <TextBlock x:Name="FileStatus" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>
     </StackPanel>
     <Grid Grid.Row="1" Margin="0,20,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ListBox x:Name="FileList" SelectionChanged="FileList_SelectionChanged"/>
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14">
       <TextBox x:Name="FilePreview"
                IsReadOnly="True"
                BorderThickness="0"
                Background="Transparent"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto"
                AcceptsReturn="True"
                TextWrapping="NoWrap"/>
      </Border>
     </Grid>
    </Grid>

    <Grid x:Name="SettingsPage" Visibility="Collapsed">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Width="820">
       <TextBlock Text="Settings" FontSize="31" FontWeight="SemiBold"/>
       <TextBlock Text="Local preferences, appearance, model connection, and update controls." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22"/>

       <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
        <StackPanel>
         <TextBlock Text="Profile &amp; privacy" FontSize="18" FontWeight="SemiBold"/>
         <TextBlock Text="Display name" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,7"/>
         <TextBox x:Name="SettingsName" Height="44"/>
         <CheckBox x:Name="SettingsSafe" Content="Safe Mode — keep ALLINONE focused on age-appropriate use." Margin="0,16,0,18"/>
         <TextBlock Text="Everything stored by ALLINONE is local unless you explicitly use an internet-enabled tool such as SearchInOne or @Website." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>

       <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,16,0,0">
        <StackPanel>
         <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold"/>
         <TextBlock Text="Choose the interface theme." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12"/>
         <StackPanel Orientation="Horizontal">
          <Button Content="☀ Light" Tag="Light" Click="Theme_Click" Width="110" Margin="0,0,8,0"/>
          <Button Content="● Dark" Tag="Dark" Click="Theme_Click" Width="110"/>
         </StackPanel>
        </StackPanel>
       </Border>

       <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,16,0,0">
        <StackPanel>
         <TextBlock Text="Local AI runtime" FontSize="18" FontWeight="SemiBold"/>
         <TextBlock Text="No cloud API key is required. ALLINONE can talk to a model server running on this Windows machine." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,14"/>

         <TextBlock Text="Provider" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/>
         <ComboBox x:Name="LocalProvider" Width="260">
          <ComboBoxItem Content="Ollama"/>
          <ComboBoxItem Content="OpenAI-compatible"/>
         </ComboBox>

         <TextBlock Text="Endpoint" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,7"/>
         <TextBox x:Name="LocalEndpoint" Height="42" Text="http://127.0.0.1:11434"/>

         <TextBlock Text="Model name" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,7"/>
         <TextBox x:Name="LocalModel" Height="42" Text=""/>

         <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <Button Content="Test connection" Width="135" Style="{StaticResource AccentButton}" Click="TestLocalAi_Click"/>
          <TextBlock x:Name="LocalStatus" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0,0,0"/>
         </StackPanel>
        </StackPanel>
       </Border>

       <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,16,0,0">
        <StackPanel>
         <TextBlock Text="Updates" FontSize="18" FontWeight="SemiBold"/>
         <TextBlock x:Name="UpdateStatus" Text="Update checks run automatically about every 14 days." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,12"/>
         <StackPanel Orientation="Horizontal">
          <Button Content="Check for updates" Width="145" Click="CheckUpdates_Click"/>
          <Button Content="Save settings" Width="135" Style="{StaticResource AccentButton}" Click="SaveSettings_Click" Margin="8,0,0,0"/>
          <Button Content="Clear current chat" Width="135" Click="ClearCurrentChat_Click" Margin="8,0,0,0"/>
         </StackPanel>
        </StackPanel>
       </Border>

       <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,16,0,24">
        <StackPanel>
         <TextBlock Text="Model roadmap" FontSize="18" FontWeight="SemiBold"/>
         <TextBlock Text="Roadmap models are labeled unavailable until a real runtime is connected. ALLINONE never pretends a missing model exists." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12"/>
         <ItemsControl x:Name="ModelStatusList"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </Grid>

    <Grid x:Name="AccountPage" Visibility="Collapsed">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Width="760">
       <TextBlock Text="Account" FontSize="31" FontWeight="SemiBold"/>
       <TextBlock Text="Optional Clerk authentication for persistent account sessions." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22"/>
       <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24">
        <StackPanel>
         <Button Content="Continue with Google" Height="48" Click="GoogleSignUp_Click" Margin="0,0,0,10"/>
         <Button Content="Continue with Apple  " Height="48" Click="AppleSignUp_Click" Margin="0,0,0,18"/>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="Sign in" Width="120" Click="SignIn_Click"/>
          <Button Content="Sign out" Width="120" Margin="8,0,0,0" Click="SignOut_Click"/>
         </StackPanel>
         <TextBlock x:Name="AuthStatus" Text="Not signed in" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
